{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },

  // Говорим TypeScript: не включай эти файлы в сборку проекта
  "exclude": [
    "jest.config.ts", // конфиг тестов лежит в корне, он не часть src
    "dist", // папка сборки
    "node_modules" // зависимости
  ]
}
